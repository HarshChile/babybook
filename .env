# BabyBook / TinyTales Environment Configuration
# Provide your MongoDB connection link below (Local or MongoDB Atlas)

# MongoDB Connection String:
# For local MongoDB: mongodb://localhost:27017
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017

# Database Name
MONGODB_DATABASE=tinytales

# Local Directory for Storing Photos and Media on Disk
UPLOAD_DIR=uploads

# Application Port (for built-in PHP server)
PORT=8000
