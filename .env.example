# Example Environment Configuration for BabyBook
# Copy this file to .env and fill in your MongoDB connection details

# MongoDB connection string (Local or MongoDB Atlas)
# Example local: MONGODB_URI=mongodb://localhost:27017
# Example Atlas: MONGODB_URI=mongodb+srv://user:password@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017

# MongoDB database name
MONGODB_DATABASE=tinytales

# Directory for storing photos on disk
UPLOAD_DIR=uploads

# Local PHP server port
PORT=8000
