# Example Environment Configuration for TinyTales BabyBook
# Copy this file to .env and configure for your environment

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example local: MONGODB_URI=mongodb://localhost:27017
# Example Atlas: MONGODB_URI=mongodb+srv://user:password@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017

# MongoDB Database Name
MONGODB_DATABASE=tinytales

# Disk Storage Directory for Uploaded Photos & Media
UPLOAD_DIR=uploads

# Local PHP Server Port
PORT=8000

# Optional SMTP Email Configuration (for password recovery emails in production)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@yourdomain.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@tinytales.app
